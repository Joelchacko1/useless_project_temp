<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/achievement_overlay_background"
    android:padding="16dp"
    android:elevation="8dp">

    <TextView
        android:id="@+id/achievement_overlay_badge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/achievement_overlay_badge_background"
        android:gravity="center"
        android:text="✓"
        android:textColor="#FFFFD928"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievement Unlocked!"
            android:textColor="#FF111111"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/achievement_overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/achievement_overlay_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3111111"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
